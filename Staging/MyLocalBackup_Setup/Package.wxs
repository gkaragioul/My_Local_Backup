<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="MyLocalBackup"
           Manufacturer="MyLocalBackup"
           Version="$(var.Version)"
           UpgradeCode="D1E2F3A4-B5C6-4D7E-8F9A-B0C1D2E3F4A5"
           InstallerVersion="500"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of MyLocalBackup is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="MsiLogging" Value="voicewarmupx" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- COMMONDESKTOPFOLDER is only set by the MSI engine in per-machine context (ALLUSERS=1).
         For per-user installs it is empty, so RemoveFile targeting it would be a no-op.
         We set it explicitly from %PUBLIC% so the cleanup component works regardless of scope. -->
    <SetProperty Id="COMMONDESKTOPFOLDER" Before="CostInitialize" Sequence="both"
                 Value="[%PUBLIC]\Desktop" />
    <Feature Id="MainFeature" Title="MyLocalBackup" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppFiles_cs" />
      <ComponentGroupRef Id="AppFiles_de" />
      <ComponentGroupRef Id="AppFiles_es" />
      <ComponentGroupRef Id="AppFiles_fr" />
      <ComponentGroupRef Id="AppFiles_it" />
      <ComponentGroupRef Id="AppFiles_ja" />
      <ComponentGroupRef Id="AppFiles_ko" />
      <ComponentGroupRef Id="AppFiles_pl" />
      <ComponentGroupRef Id="AppFiles_pt_BR" />
      <ComponentGroupRef Id="AppFiles_ru" />
      <ComponentGroupRef Id="AppFiles_tr" />
      <ComponentGroupRef Id="AppFiles_zh_Hans" />
      <ComponentGroupRef Id="AppFiles_zh_Hant" />
      <ComponentGroupRef Id="ApplicationShortcuts" />
    </Feature>
  </Package>

  <Fragment>
    <!-- Per-user install: %LOCALAPPDATA%\Programs\MyLocalBackup - no admin/UAC required -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="MyLocalBackup" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MyLocalBackup" />
    </StandardDirectory>

    <!-- User desktop (per-user MSI resolves DesktopFolder to %USERPROFILE%\Desktop) -->
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <!-- COMMONDESKTOPFOLDER = C:\Users\Public\Desktop, set via SetProperty above.
       Declared under TARGETDIR so RemoveFile can reference it as a directory. -->
  <Fragment>
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="COMMONDESKTOPFOLDER" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ApplicationShortcuts">
      <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="A9C8A4A1-1D3C-4EED-9F6F-BF9F4B2EAA11">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="MyLocalBackup"
                  Description="MyLocalBackup"
                  Target="[INSTALLFOLDER]MyLocalBackup.UI.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  IconIndex="0" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\MyLocalBackup" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="5F2CA1A2-9C67-4A7F-90AF-A2C4A9DF0D22">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="MyLocalBackup"
                  Description="MyLocalBackup"
                  Target="[INSTALLFOLDER]MyLocalBackup.UI.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\MyLocalBackup" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Removes the leftover MyLocalBackup.lnk from C:\Users\Public\Desktop that old per-machine
           installers (v0.8.x/v0.9.0/v0.9.1/v0.9.2) left behind. COMMONDESKTOPFOLDER is set to
           [%PUBLIC]\Desktop via SetProperty above so this cleanup works in per-user context. -->
      <Component Id="RemoveOldPublicDesktopShortcut" Directory="COMMONDESKTOPFOLDER" Guid="B2C3D4E5-F6A7-4B8C-9D0E-F1A2B3C4D5E6">
        <RemoveFile Id="RemoveOldPublicDesktopLnk" Name="MyLocalBackup.lnk" On="install" />
        <RegistryValue Root="HKCU" Key="Software\MyLocalBackup" Name="CleanedPublicShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>

