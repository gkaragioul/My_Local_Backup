# .gitignore for MyLocalBackup (.NET/WPF)

# Strong name key (private key — never commit)
*.snk

# Build results
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esults/
publish/

# Visual Studio
.vs/
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.suo

# Visual Studio Code
.vscode/

# OS generated files
.DS_Store
Thumbs.db

# MyLocalBackup Local Data (Avoid pushing user config/db)
MyLocalBackup_Snapshots/
config.json
metadata.db
**/MyLocalBackup_Snapshots/
**/config.json
**/metadata.db
*.db-wal
*.db-shm
*.db-journal

# Build artifacts and installer
*.key
*.msi
# Ignore build-generated XML (NuGet props, targets, etc.) but not source XML
**/[Bb]in/**/*.xml
**/[Oo]bj/**/*.xml
Staging/*
# Track WiX installer source files and icon despite Staging/ being ignored
!Staging/MyLocalBackup_Setup/
Staging/MyLocalBackup_Setup/*
!Staging/MyLocalBackup_Setup/Package.wxs
!Staging/MyLocalBackup_Setup/app.ico
# Files.wxs is auto-generated by release-build.ps1 — do not track

# Temp files
test.bat
build_log.txt
*_Website_Features.md
