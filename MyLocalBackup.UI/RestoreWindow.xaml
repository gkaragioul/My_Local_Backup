<Window x:Class="MyLocalBackup.UI.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyLocalBackup.UI"
        Title="Restore History" Height="500" Width="800"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True">

    <Window.Resources>
        <local:UtcToLocalConverter x:Key="UtcToLocal"/>
        <Style x:Key="TimelineButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Title Bar -->
            <Grid DockPanel.Dock="Top" Height="40">
                <TextBlock Text="Restore History" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" Width="46" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- Timeline -->
            <Border DockPanel.Dock="Top" Height="80" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Snapshots}" Margin="20,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Timestamp, Converter={StaticResource UtcToLocal}, StringFormat='{}{0:MM/dd HH:mm}'}"
                                              Style="{StaticResource TimelineButtonStyle}"
                                              Click="OnSnapshotClicked" Tag="{Binding Id}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- File List -->
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Files in Snapshot" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ListBox Name="FileListBox" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" SelectionChanged="FileList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextMutedBrush}" Margin="5,5,10,5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RelativePath}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,5,5,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="Selection" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource CardBrush}" Padding="15" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Name="TxtSelectedFile" Text="No file selected" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Button Name="BtnRestore" Content="Restore File..." Click="BtnRestore_Click" Padding="10" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>

</Window>
