<UserControl x:Class="MyLocalBackup.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyLocalBackup.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="App Settings" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Backup Interval -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Backup Schedule" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,25">
                        <StackPanel>
                            <CheckBox x:Name="ChkAutoBackup" Content="Enable automatic backups" Margin="0,0,0,15"
                                      Checked="ChkAutoBackup_Changed" Unchecked="ChkAutoBackup_Changed" Foreground="{DynamicResource TextBrush}"/>

                            <!-- Schedule Mode Selection -->
                            <StackPanel x:Name="PanelScheduleMode" Margin="0,0,0,15">
                                <RadioButton x:Name="RbInterval" Content="Every X hours" GroupName="ScheduleMode" Margin="0,0,0,8"
                                             Checked="ScheduleMode_Changed" Foreground="{DynamicResource TextBrush}"/>
                                <RadioButton x:Name="RbDailyTime" Content="Once per day at a specific time" GroupName="ScheduleMode"
                                             Checked="ScheduleMode_Changed" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>

                            <!-- Interval Controls -->
                            <StackPanel x:Name="PanelInterval">
                                <TextBlock Text="Interval (Hours)" Margin="0,0,0,5" Foreground="{DynamicResource TextMutedBrush}"/>
                                <Slider x:Name="SldInterval" Minimum="1" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="SldInterval_ValueChanged"/>
                                <TextBlock x:Name="TxtInterval" Text="Every 4 hours" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>

                            <!-- Daily Time Controls -->
                            <StackPanel x:Name="PanelDailyTime" Visibility="Collapsed">
                                <TextBlock Text="Backup Time" Margin="0,0,0,8" Foreground="{DynamicResource TextMutedBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="CmbHour" Width="60" SelectionChanged="DailyTime_Changed"/>
                                    <TextBlock Text=" : " VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="4,0" Foreground="{DynamicResource TextBrush}"/>
                                    <ComboBox x:Name="CmbMinute" Width="60" SelectionChanged="DailyTime_Changed"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtDailyTime" Text="Daily at 02:00" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- General -->
                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="General" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,0,25">
                        <StackPanel>
                            <CheckBox x:Name="ChkMinimizeTray" Content="Minimize to tray when closed" Margin="0,0,0,15" Checked="Setting_Changed" Unchecked="Setting_Changed" Foreground="{DynamicResource TextBrush}"/>
                            <CheckBox x:Name="ChkAutoDelete" Content="Automatically delete old backups if disk is full" Margin="0,0,0,15" Checked="Setting_Changed" Unchecked="Setting_Changed" Foreground="{DynamicResource TextBrush}"/>
                            <CheckBox x:Name="ChkShowNotifications" Content="Show notifications for every backup" Checked="Setting_Changed" Unchecked="Setting_Changed" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Logs Section with Tabs -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Header Row -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnTabLogs" Content="Activity Log" Click="BtnTabLogs_Click"
                            Style="{StaticResource LinkButtonStyle}"
                            FontWeight="SemiBold" FontSize="14" Padding="0,4,12,4" Margin="0,0,4,0"
                            Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="|" VerticalAlignment="Center" Foreground="{DynamicResource BorderBrush}" Margin="0,0,4,0"/>
                    <Button x:Name="BtnTabFailed" Click="BtnTabFailed_Click"
                            Style="{StaticResource LinkButtonStyle}"
                            FontSize="14" Padding="0,4,12,4"
                            Foreground="{DynamicResource TextMutedBrush}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtTabFailedLabel" Text="Skipped Files"/>
                                <Border x:Name="BadgeFailedCount" Background="{DynamicResource ErrorBrush}" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtFailedCount" Text="0" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="PanelLogActions" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Copy Logs" Click="BtnCopyLogs_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{DynamicResource PrimaryBrush}"/>
                    <Button Content="Clear" Click="BtnClearLogs_Click" Style="{StaticResource LinkButtonStyle}" Foreground="{DynamicResource ErrorBrush}" Margin="5,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Activity Log Panel -->
            <Border x:Name="PanelActivityLog" Grid.Row="1" Style="{StaticResource GlassCardStyle}" Background="{DynamicResource CardBrush}">
                <ListBox x:Name="LstLogs" BorderThickness="0" Background="Transparent" Padding="10"
                         ItemsSource="{Binding Source={x:Static local:UILogger.Logs}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Failed Files Panel -->
            <Border x:Name="PanelFailedFiles" Grid.Row="1" Style="{StaticResource GlassCardStyle}" Background="{DynamicResource CardBrush}" Visibility="Collapsed">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel x:Name="PanelFailedEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="No skipped files" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="All files from the last backup were processed successfully." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Failed Files List -->
                    <ListBox x:Name="LstFailedFiles" BorderThickness="0" Background="Transparent" Padding="10"
                             ItemsSource="{Binding Source={x:Static local:UILogger.FailedFiles}}"
                             MouseDoubleClick="LstFailedFiles_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ErrorBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                                        <Button DockPanel.Dock="Right" Content="Show in Explorer" Click="BtnShowInExplorer_Click"
                                                Style="{DynamicResource TransparentButtonStyle}" Foreground="{DynamicResource PrimaryBrush}"
                                                FontSize="11" Padding="8,2" Cursor="Hand" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
